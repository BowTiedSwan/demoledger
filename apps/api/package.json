{
  "name": "@demoledger/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke:live": "tsx --env-file-if-exists=../../.env scripts/smoke-live.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.81",
    "@demoledger/db": "workspace:*",
    "@demoledger/shared": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "ai": "7.0.157",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
