# DemoLedger configuration. Copy to .env (never commit .env).
# All values below are local-development placeholders.

# ---------------------------------------------------------------------------
# PostgreSQL (docker compose, host port 5433)
# ---------------------------------------------------------------------------
# Superuser/owner created by the postgres image. Owns the schema; used only by
# migrations, roles.sql and the seed. Never used by the running API.
POSTGRES_USER=demoledger_owner
POSTGRES_PASSWORD=demoledger_owner_dev_pw

# Passwords for the two least-privilege app roles (created by
# packages/db/src/roles.sql during `pnpm db:reset`).
LEDGER_READER_PASSWORD=ledger_reader_dev_pw
LEDGER_APP_PASSWORD=ledger_app_dev_pw

# Dev database (demoledger)
# owner: migrations / roles / seed only
DATABASE_URL=postgres://demoledger_owner:demoledger_owner_dev_pw@localhost:5433/demoledger
# ledger_reader: SELECT on transactions only (tool handlers + /api/transactions*)
DATABASE_URL_READER=postgres://ledger_reader:ledger_reader_dev_pw@localhost:5433/demoledger
# ledger_app: Better Auth tables + INSERT-only on audit tables
DATABASE_URL_APP=postgres://ledger_app:ledger_app_dev_pw@localhost:5433/demoledger

# Test database (demoledger_test). vitest maps TEST_DATABASE_URL* onto
# DATABASE_URL* for every test run, so tests never touch the dev database.
TEST_DATABASE_URL=postgres://demoledger_owner:demoledger_owner_dev_pw@localhost:5433/demoledger_test
TEST_DATABASE_URL_READER=postgres://ledger_reader:ledger_reader_dev_pw@localhost:5433/demoledger_test
TEST_DATABASE_URL_APP=postgres://ledger_app:ledger_app_dev_pw@localhost:5433/demoledger_test

# Per-statement timeout applied to both app pools (ms).
DB_STATEMENT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
API_PORT=3001
# trace | debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Better Auth (embedded in the API)
# ---------------------------------------------------------------------------
# 32+ random chars. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
# Public base URL of the auth server (the API).
BETTER_AUTH_URL=http://localhost:3001
# Comma-separated origins allowed to call auth endpoints (Vite dev server + API).
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3001

# ---------------------------------------------------------------------------
# LLM: Cloudflare Workers AI (Free plan), OpenAI-compatible endpoint
# Leave CF_* empty to run without an LLM: /api/ask then returns llm_unconfigured.
# ---------------------------------------------------------------------------
CF_ACCOUNT_ID=
# API token with "Workers AI: Read" permission only.
CF_API_TOKEN=
# Default model (ADR 0007, D-23). Fallback: @cf/openai/gpt-oss-120b (about 2.4x the Neurons; leaked tool-call markup in live use).
LLM_MODEL=@cf/google/gemma-4-26b-a4b-it
# Optional override. Default: https://api.cloudflare.com/client/v4/accounts/$CF_ACCOUNT_ID/ai/v1
LLM_BASE_URL=
# Whole /api/ask request budget (ms), enforced with an AbortSignal. The only wall-clock bound.
LLM_REQUEST_TIMEOUT_MS=45000
# Max wait (ms) for the first streamed chunk of each model step (idle-based, not a wall-clock cap).
LLM_STEP_TIMEOUT_MS=15000
# low | medium | high. Reasoning effort, mapped per model family: gpt-oss -> reasoning_effort, GLM -> thinking
# (low = off). No effect on Gemma (the default). Higher = slower, more Neurons.
LLM_REASONING_EFFORT=low
# Output token cap per model step (reasoning tokens count too). A capped answer is audited
# error_code=truncated and the UI warns that it was cut off (finding F-22).
LLM_MAX_OUTPUT_TOKENS=2048
# Retries per model call on 429/5xx (exponential backoff).
LLM_MAX_RETRIES=2
# Hard cap on agent steps (tool-call rounds) per question.
LLM_MAX_STEPS=5

# ---------------------------------------------------------------------------
# Prompt-injection guard (runs before the LLM)
# ---------------------------------------------------------------------------
# clef | heuristic | none. Empty = clef when CF_* is set, otherwise heuristic.
# `none` is for tests only.
GUARD_PROVIDER=
# System One decision model used by the clef provider.
GUARD_MODEL=@cf/cloudflare/clef-flash
# Optional override. Default: https://api.cloudflare.com/client/v4/accounts/$CF_ACCOUNT_ID/ai/run
GUARD_BASE_URL=
# open | closed. What to do when the guard errors or times out.
GUARD_FAIL_MODE=open
# Clef time budget (ms). On timeout or error the local heuristic still runs (F-23):
# a heuristic block still blocks; otherwise the verdict is `unavailable` and GUARD_FAIL_MODE decides.
GUARD_TIMEOUT_MS=2500

# ---------------------------------------------------------------------------
# Abuse limits
# ---------------------------------------------------------------------------
# Set true only behind an ingress that overwrites X-Forwarded-For; otherwise login throttling
# uses the TCP peer address (OWASP-02).
TRUST_PROXY_HEADERS=false
# Per-user /api/ask requests per minute (in-memory limiter).
ASK_RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Seed
# ---------------------------------------------------------------------------
# ISO timestamp the 100 seed transactions are offset from.
# Empty = start of the current UTC day (so "yesterday"/"this week" have data).
# Tests always pin 2026-10-28T00:00:00Z.
SEED_ANCHOR=
